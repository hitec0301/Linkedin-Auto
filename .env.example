# TEMPLATE ONLY - copy this to .env and put your real values THERE.
#
#   .env          your real values. Gitignored. This is what the code reads.
#   .env.example  this file. Placeholders only. It is committed to git, so a
#                 real value here becomes part of the repository history.
#   GitHub Actions  neither file. Repository Settings -> Secrets and variables
#                 -> Actions -> New repository secret, one per name below.

# Copy to .env for local runs. .env is gitignored; never commit real values.
# In GitHub Actions these same names come from repository secrets.

# --- Anthropic -------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- Google Sheets ---------------------------------------------------------
# Either a path to the service-account key file (local) or the whole JSON blob
# on one line (GitHub Actions). Both forms are accepted.

GOOGLE_SA_JSON=.secrets/service-account.json
# The long id from the Sheet URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit

SHEET_ID=
