# Copy to .env for local runs. .env is gitignored; never commit real values.
# In GitHub Actions these same names come from repository secrets.

# --- Anthropic -------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- Google Sheets ---------------------------------------------------------
# Either a path to the service-account key file (local) or the whole JSON blob
# on one line (GitHub Actions). Both forms are accepted.
GOOGLE_SA_JSON=.secrets/service-account.json
# The long id from the Sheet URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=

# --- LinkedIn --------------------------------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Token storage in CI ---------------------------------------------------
# A GitHub Actions run cannot write a rotated refresh token back into its own
# repository secrets, so rotation is persisted to a private Gist instead.
# GIST_TOKEN is a fine-grained PAT with gist read/write scope and nothing else.
GIST_ID=
GIST_TOKEN=

# --- Alerts ----------------------------------------------------------------
# Slack is tried first. SMTP is the fallback. There is always a log line.
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# --- Optional ingestion sources (both off by default in config.yaml) --------
GMAIL_USER=
GMAIL_APP_PASSWORD=

# LOG_LEVEL=INFO
