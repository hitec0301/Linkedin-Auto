# TEMPLATE ONLY - copy this to .env and put your real values THERE.
#
#   .env          your real values. Gitignored. This is what the code reads.
#   .env.example  this file. Placeholders only. It is committed to git, so a
#                 real value here becomes part of the repository history.
#   your host     neither file. Set these as variables on the project.

# --- Database --------------------------------------------------------------
# On a host, reference the Postgres service's own variable rather than pasting
# the string, so a recreated database does not strand every service on a
# hostname that no longer resolves. postgres:// and postgresql:// are both
# accepted; the code rewrites either to the driver it uses.
DATABASE_URL=postgresql://localhost/lnp

# --- Secrets, from `python scripts/gen_keys.py` -----------------------------
# Signs session cookies. Changing it signs everyone out.
LNP_SECRET_KEY=
# Encrypts stored LinkedIn credentials. NOT rotatable: change it and every
# customer has to reconnect. Back it up somewhere other than the database.
LNP_ENCRYPTION_KEY=

# --- Where this deployment lives -------------------------------------------
# No trailing slash. The sign-in redirect URL is built from it, and it has to
# match what is registered on the LinkedIn app character for character.
LNP_BASE_URL=http://localhost:8000

# Only for a plain-HTTP local run. Without it the session cookie is Secure and
# a browser on http:// drops it. Never set this on a deployment.
# LNP_INSECURE_COOKIES=1

# --- Sign in with LinkedIn -------------------------------------------------
# Your own LinkedIn app, used only to identify people. It cannot post: that
# needs w_member_social, which each customer grants through their own app.
LNP_AUTH_CLIENT_ID=
LNP_AUTH_CLIENT_SECRET=

# --- Anthropic -------------------------------------------------------------
# Yours. The operator pays for drafting, which is why usage is capped per
# account in the database rather than trusted to stay reasonable.
ANTHROPIC_API_KEY=sk-ant-...

# --- Alerting --------------------------------------------------------------
# Optional, and the only way you hear that a scheduled run failed.
SLACK_WEBHOOK_URL=
