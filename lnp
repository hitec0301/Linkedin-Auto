#!/usr/bin/env bash
#
# Every command, without activating anything.
#
#   ./lnp setup     configure credentials, checking each one
#   ./lnp check     verify the install and the credentials
#   ./lnp curate    put this week's candidates in the sheet
#   ./lnp draft     draft the rows you selected
#   ./lnp publish   post approved rows (dry run until you turn it off)
#   ./lnp voice     propose voice rules from your corrections
#   ./lnp test      run the test suite
#
set -u
cd "$(dirname "$0")" || exit 1
PY="./.venv/bin/python"

if [ ! -x "$PY" ]; then
  echo "Not installed yet. Run:  ./setup.sh"
  exit 1
fi

case "${1:-}" in
  setup)   shift; exec "$PY" scripts/wizard.py "$@" ;;
  check)   shift; exec "$PY" scripts/wizard.py --recheck "$@" ;;
  doctor)  shift; exec bash scripts/doctor.sh "$@" ;;
  curate)  shift; exec "$PY" jobs/curate.py "$@" ;;
  draft)   shift; exec "$PY" jobs/draft.py "$@" ;;
  publish) shift; exec "$PY" jobs/publish.py "$@" ;;
  voice)   shift; exec "$PY" jobs/voice_amend.py "$@" ;;
  sources) shift; exec "$PY" scripts/validate_sources.py "$@" ;;
  sheet)   shift; exec "$PY" scripts/setup_sheet.py "$@" ;;
  oauth)   shift; exec "$PY" scripts/oauth_bootstrap.py "$@" ;;
  test)    shift; exec "$PY" -m pytest "$@" ;;
  python)  shift; exec "$PY" "$@" ;;
  ""|-h|--help|help)
    awk 'NR>2 && /^#/ {sub(/^# ?/,""); print; next} NR>2 {exit}' "$0" ;;
  *)
    echo "Unknown command: $1"; echo
    awk 'NR>2 && /^#/ {sub(/^# ?/,""); print; next} NR>2 {exit}' "$0"; exit 1 ;;
esac
